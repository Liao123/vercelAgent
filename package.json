{
  "name": "vec-next",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "validate:compaction": "npx --yes tsx scripts/validate-loop-compaction.ts",
    "validate:thread-memory": "npx --yes tsx scripts/validate-thread-continuation.ts",
    "validate:loop-state": "npx --yes tsx scripts/validate-loop-state.ts",
    "validate:git-status": "npx --yes tsx scripts/validate-git-status.ts",
    "validate:content-snapshot": "npx --yes tsx scripts/validate-content-snapshot.ts",
    "validate:long-thread-compaction": "npx --yes tsx scripts/validate-long-thread-compaction.ts",
    "trial:long-thread": "node scripts/long-thread-compaction-trial.mjs",
    "trial:semantic-compare": "node scripts/semantic-compact-compare.mjs",
    "validate:agent": "npm run validate:compaction && npm run validate:thread-memory && npm run validate:loop-state && npm run validate:git-status && npm run validate:content-snapshot && npm run validate:long-thread-compaction"
  },
  "dependencies": {
    "next": "16.2.6",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
