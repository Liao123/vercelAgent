# ── 方式 A：GPT 中转（OpenAI 兼容，推荐）──────────────────
# 与 Codex 的 base_url 相同即可，不必带 /v1（代码会自动拼 /v1/chat/completions）
# 例：鹊桥 Codex 里 base_url = "https://queqiao.online"
OPENAI_API_BASE=https://queqiao.online
OPENAI_API_KEY=sk-your-relay-key
# 勿填 gpt-4o（Codex 专用）。推荐 gpt-5.5，也可 gpt-5.4、gpt-5.4-mini
OPENAI_MODEL=gpt-5.5
OPENAI_VISION_MODEL=gpt-5.5
OPENAI_IMAGE_MODEL=gpt-image-1
# 中转绘图 502 时是否启用备用绘图（设为 false 可关闭）
# IMAGE_FALLBACK=false

# ── 方式 B：DeepSeek 官方（不填上面三项时用这项）──────────
# DEEPSEEK_API_KEY=sk-your-deepseek-key
# DEEPSEEK_MODEL=deepseek-chat

# ── Agent Loop 上下文压缩（可选调优）────────────────────
# AGENT_LOOP_SEMANTIC_COMPACT=false   # 关闭语义压缩，仅确定性 compact
# AGENT_LOOP_TAIL_KEEP=12             # tail 最多保留 N 条
# AGENT_LOOP_BURST_TAIL_MIN=4         # A126 爆发段 tail 至少 N 条
# AGENT_LOOP_BURST_TAIL=0             # 关闭爆发段 tail，回退固定 tailKeep
# AGENT_LOOP_MIDDLE_MSG_TRIGGER=8     # middle 消息数达到后更易触发压缩
# AGENT_LOOP_MIDDLE_TOKEN_TRIGGER=4000
# AGENT_LOOP_SKIP_REASONING=1        # 关闭首轮 [TASK_REASONING] JSON 推理轮
# AGENT_LOOP_ADAPTIVE_REASONING=0    # 关闭自适应跳过推理（默认开：只读/会话 follow-up 注入 [REASONING_SKIPPED]）
# AGENT_LOOP_PARALLEL_GATHER=0       # 关闭单轮并行 gather（默认开）
# AGENT_LOOP_SHELL_RESUME=0          # 关闭 shell 批准后同 Loop 上下文续跑（默认开）
# AGENT_PTY_ENABLED=0                # 关闭右栏交互式 PTY 终端（默认开）

# ── MCP 市场服务器（可选，与 Cursor mcp.json 格式兼容）────────
# AGENT_MCP_ENABLED=1                # 显式开启；设为 0 关闭
# AGENT_MCP_CONFIG=D:/path/to/mcp.json # 配置文件路径（默认可用 ./mcp.json 或 ~/.cursor/mcp.json）
# AGENT_MCP_SERVERS={"mcpServers":{"chrome-devtools":{"command":"npx","args":["-y","chrome-devtools-mcp@latest"]}}}
# AGENT_MCP_CONNECT_TIMEOUT_MS=25000   # 单 MCP 服务器连接超时（默认 25s）
# AGENT_SERVER_PORT=3920               # 本地 agent-server 端口（长驻 MCP）
# AGENT_SERVER_URL=http://127.0.0.1:3920  # Next 通过 HTTP 复用 agent-server 的 MCP + Loop（npm run agent-server）
# AGENT_LOOP_REMOTE=0              # 默认建议：仅 MCP/PTY 走 agent-server，Loop 留在 Next（读 .env.local）
# AGENT_LOOP_REMOTE=1              # 全开远程：Loop 也走 agent-server（agent-server 会加载 .env/.env.local）；此时 /api/agent/traces 代理 /trace
# AGENT_PTY_REMOTE=0               # 仅 MCP/Loop 走 agent-server，PTY 仍在 Next 进程
# AGENT_KERNEL_BOOTSTRAP=0         # 关闭受控自举（禁止写 src/agent 内核；.env 等始终禁止）
# AGENT_KERNEL_AUTO_VALIDATE=0     # 内核改完后不自动 shell.run.prepare validate 命令
# AGENT_KERNEL_RESTART_COMMAND=npm run dev   # validate 通过后「复制重启命令」的默认文案（默认 dev:desktop）
# AGENT_LOOP_GRACEFUL_RECOVERY=0       # 关闭阶段 B 韧性（edit.recovery 全开 + 模型失败确定性兜底）
# AGENT_LOOP_DETERMINISTIC_RECOVERY=0  # 仅关闭模型失败时的无 LLM 兜底（graceful 仍开时 edit.recovery 仍开）
# AGENT_MODEL_RETRY=0                # 关闭模型 API 可重试错误退避（默认开，524/502 等）
# AGENT_MODEL_RETRY_MAX=1            # 最大重试次数（默认 1）
# AGENT_PROJECT_INDEX_CACHE_TTL_MS=0 # 关闭会话级 project index 缓存（默认 5 分钟）
